%YAML:1.0

#--------------------------------------------------------------------------------------------
# Camera Parameters. Calibrated using Kalibr with April grid.
# OV9281 global shutter monochrome camera, 640x400
#--------------------------------------------------------------------------------------------
Camera.type: "PinHole"

# Camera intrinsics from Kalibr calibration (2025-12-26)
Camera.fx: 467.6812306800337
Camera.fy: 473.54154155725905
Camera.cx: 331.0972806675792
Camera.cy: 187.42075600700787

# Distortion parameters (radtan model: k1, k2, p1, p2)
Camera.k1: -0.3911483697660045
Camera.k2: 0.1302886701765253
Camera.p1: 0.007681273999517641
Camera.p2: -0.001592366891449487

# Camera resolution
Camera.width: 640
Camera.height: 400

# Camera frames per second
Camera.fps: 20.0

# Color order of the images (0: BGR, 1: RGB, 2: Grayscale)
Camera.RGB: 0

#--------------------------------------------------------------------------------------------
# IMU Parameters. BMI160 IMU via Raspberry Pi Pico.
# Noise parameters from Kalibr IMU-camera calibration.
#--------------------------------------------------------------------------------------------

# IMU noise parameters (continuous-time, from Kalibr)
IMU.NoiseGyro: 0.000187
IMU.NoiseAcc: 0.00186
IMU.GyroWalk: 2.66e-05
IMU.AccWalk: 0.000433

# IMU sampling frequency
IMU.Frequency: 200

#--------------------------------------------------------------------------------------------
# Camera-IMU Extrinsic Calibration (Tbc: Body/IMU to Camera transformation)
#--------------------------------------------------------------------------------------------

# T_cam_imu from Kalibr calibration (2025-12-26)
# Transforms points from IMU frame to camera frame
Tbc: !!opencv-matrix
   rows: 4
   cols: 4
   dt: f
   data: [-0.9994949377717415, -0.002615866983061566, 0.031670595330528725, -0.001175854610620385,
          0.0031939171249797515, -0.9998289891451475, 0.018215140910566946, 0.006177426154609258,
          0.031617530929247795, 0.018307094387695087, 0.9993323681503659, -0.08140201506494665,
          0.0, 0.0, 0.0, 1.0]

# Time offset: Time_camera = Time_imu + td (in seconds)
# From Kalibr timeshift_cam_imu: 0.012123041957760858
Camera.TimeOffset: 0.012123041957760858

# Insert KFs when there is no visual odometry
IMU.InsertKFsWhenLost: 0

#--------------------------------------------------------------------------------------------
# ORB Parameters
#--------------------------------------------------------------------------------------------

# ORB Extractor: Number of features per image
# Increased from 800 to 1200 for more robust tracking
ORBextractor.nFeatures: 1200

# ORB Extractor: Scale factor between levels in the scale pyramid
ORBextractor.scaleFactor: 1.2

# ORB Extractor: Number of levels in the scale pyramid
ORBextractor.nLevels: 8

# ORB Extractor: Fast threshold
# Lowered thresholds slightly for better feature detection in low-texture areas
ORBextractor.iniThFAST: 15
ORBextractor.minThFAST: 5

#--------------------------------------------------------------------------------------------
# Viewer Parameters
#--------------------------------------------------------------------------------------------
Viewer.KeyFrameSize: 0.05
Viewer.KeyFrameLineWidth: 1.0
Viewer.GraphLineWidth: 0.9
Viewer.PointSize: 2.0
Viewer.CameraSize: 0.08
Viewer.CameraLineWidth: 3.0
Viewer.ViewpointX: 0.0
Viewer.ViewpointY: -0.7
Viewer.ViewpointZ: -1.8
Viewer.ViewpointF: 500.0

Viewer.imageViewScale: 1.0
